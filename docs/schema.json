{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/boinger/confvis/docs/schema.json",
  "title": "Confidence Report",
  "description": "Schema for confvis confidence reports",
  "type": "object",
  "required": ["title", "threshold"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Report title, displayed in dashboard header"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Overall confidence score (0-100). Auto-calculated from factors if omitted"
    },
    "threshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Minimum passing score. Score >= threshold = PASS"
    },
    "description": {
      "type": "string",
      "description": "Detailed report description"
    },
    "thresholds": {
      "type": "object",
      "description": "Custom color thresholds for gauge display",
      "properties": {
        "greenAbove": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 75,
          "description": "Minimum score for green (success) color"
        },
        "yellowAbove": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50,
          "description": "Minimum score for yellow (warning) color"
        }
      },
      "additionalProperties": false
    },
    "factors": {
      "type": "array",
      "description": "Contributing factors breakdown",
      "items": {
        "$ref": "#/$defs/factor"
      }
    },
    "version": {
      "type": "string",
      "description": "Report version identifier"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when report was generated"
    },
    "source": {
      "type": "string",
      "description": "Origin of the report (e.g., 'ci-pipeline', 'manual')"
    },
    "passLabel": {
      "type": "string",
      "default": "PASS",
      "description": "Custom label for passing status"
    },
    "failLabel": {
      "type": "string",
      "default": "FAIL",
      "description": "Custom label for failing status"
    },
    "passed": {
      "type": "boolean",
      "description": "Serialization-only field emitted by producers (aggregate, gauge) on round-trip. Not authoritative; pass/fail is computed from score and threshold"
    },
    "baseline": {
      "type": "integer",
      "description": "Serialization-only field: the baseline score this report was compared against, when applicable"
    },
    "delta": {
      "type": "integer",
      "description": "Serialization-only field: score change versus baseline, when applicable"
    }
  },
  "$defs": {
    "factor": {
      "type": "object",
      "required": ["name", "score", "weight"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Factor name (e.g., 'Test Coverage')"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Factor score (0-100)"
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Relative weight in calculations"
        },
        "threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum acceptable score for this factor (0-100)"
        },
        "description": {
          "type": "string",
          "description": "Explanation of this factor"
        },
        "details": {
          "type": "string",
          "description": "Producer-emitted short blurb for this factor; rendered via the description fallback in the gauge factor-breakdown table"
        },
        "breakdown": {
          "type": "object",
          "description": "Optional producer-defined score decomposition keyed by sub-component name (e.g. 'direct', 'transitive'); informational, not authoritative",
          "additionalProperties": {
            "type": "object",
            "required": ["outdated", "score"],
            "properties": {
              "outdated": {
                "type": "integer",
                "description": "Count of outdated items in this sub-component"
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Sub-component score (0-100)"
              }
            },
            "additionalProperties": false
          }
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Link to detailed report"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
